# ============ CoreMind LLM providers (optional) ============
# The KB retrieval engine works WITHOUT any API key (returns top-match answers).
# Configure at least one of these to enable LLM fallback for nuanced/complex questions.

# Groq — FREE tier, fast inference (llama-3.3-70b)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude — paid (used as secondary fallback)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
